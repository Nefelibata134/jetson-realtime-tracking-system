# 合并到既有 edge-vision.env 的可选事件配置，需先部署支持这些参数的程序和启动器。
# 不切换 engine、功率、时钟或检测阈值；ROI/警戒线必须适配实际画面。
# 仅保存事件 JSONL、截图和片段，不启用全程录像或测试预览。
EDGE_VISION_MATCH_THRESHOLD=0.8
EDGE_VISION_EVENT_LINE="0.50 0.35 0.50 0.95"
EDGE_VISION_EVENT_LINE_DIRECTION=any
EDGE_VISION_EVENT_LINE_CONFIRM_SECONDS=0.2
EDGE_VISION_EVENT_ROI_EXIT_MARGIN=0.02
EDGE_VISION_EVENT_ROI_EXIT_SECONDS=0.5
EDGE_VISION_EVENT_CLIP_ENCODER=x264
EDGE_VISION_EVENT_CLIP_CAPACITY=8
EDGE_VISION_EVENT_CLIP_BITRATE_KBPS=10000
EDGE_VISION_EVENT_CLIP_SHARE_OVERLAP=1
EDGE_VISION_EVENT_CLIP_MAX_SHARED_SECONDS=6
EDGE_VISION_EVENT_CLIP_MAX_SHARED_EVENTS=32
